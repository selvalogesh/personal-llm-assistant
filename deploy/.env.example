# The OMV Compose stack "Chat"'s environment, read with OMV's global.env (CHAT: the host folder holding data/ and
# secrets/). OMV commits this file to git, so passwords go in secrets files, never here. Every variable is
# required: compose.yaml has no defaults.

# Host port your proxy or tunnel points openai.selvalogesh.com at. "127.0.0.1:8020" keeps it off the LAN when the
# tunnel runs on this host; "8020" publishes it on every interface.
CHAT_UI_PORT=127.0.0.1:8020
# The public address, used in links and emails Open WebUI makes
CHAT_WEBUI_URL=https://openai.selvalogesh.com
# The admin account Open WebUI creates on the first start. Its password is in secrets/webui-admin-password.
CHAT_ADMIN_EMAIL=<your email>
# Speech-to-text model: base.en (fast) or small.en (more accurate, slower on the N100)
CHAT_WHISPER_MODEL=base.en
