# Our Open WebUI settings, loaded by entrypoint.sh over the official image's defaults (CR-2 §3.3). Settings only,
# never secrets: those come from the read-only secrets folder at start. Open WebUI saves most settings to its
# database on the first start; after that, change them in Admin → Settings.
# Plain KEY=value lines only (bash sources this file and the tests parse it). Never set a variable the compose
# environment sets (WEBUI_URL, WEBUI_ADMIN_EMAIL, WHISPER_MODEL): this file would silently win (D6).

# Only the Router's options appear (D6); every user sees them (R2)
ENABLE_OPENAI_API=false
ENABLE_OLLAMA_API=false
BYPASS_MODEL_ACCESS_CONTROL=true
ENABLE_EVALUATION_ARENA_MODELS=false
ENABLE_COMMUNITY_SHARING=false
# Sign-ups wait for the admin's approval (R3); load_functions.py turns them back on after the admin is created
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending
# Web search and image generation go through the Router's toggles, not Open WebUI's own engines
ENABLE_WEB_SEARCH=false
ENABLE_IMAGE_GENERATION=false
# Document search: embeddings on the server, with Open WebUI's own engine (CR-3); nothing goes to OpenRouter
RAG_EMBEDDING_ENGINE=
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Voice (R15): Whisper in this container (its model comes from the stack environment), Kokoro in the stack
AUDIO_STT_ENGINE=
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=http://kokoro:8880/v1
AUDIO_TTS_MODEL=kokoro
AUDIO_TTS_VOICE=af_heart
# Python for charts and drawn images runs in the browser (R9)
ENABLE_CODE_INTERPRETER=true
CODE_INTERPRETER_ENGINE=pyodide
